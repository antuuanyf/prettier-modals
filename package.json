{
  "name": "prettier-modals-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Prettier Modals — vanilla core + Angular wrapper.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w prettier-modals",
    "build:angular": "npm run build -w prettier-modals-angular",
    "pack:all": "npm run build:core && npm run build:angular && mkdir -p artifacts && npm pack ./packages/core --pack-destination artifacts && npm pack ./packages/angular/dist --pack-destination artifacts",
    "publish:core": "npm run build:core && npm publish ./packages/core",
    "publish:angular": "npm run build:angular && npm publish ./packages/angular/dist",
    "demo": "http-server . -p 8080 -c-1 -o /demo/",
    "demo:angular": "npm --prefix demos/angular start",
    "build:demo:angular": "npm --prefix demos/angular run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "http-server": "^14.1.1"
  }
}
